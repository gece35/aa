# Nebula Scanner — environment variables
# Copy to .env and fill in. Never commit .env.

# Flask
SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:5000
LOG_LEVEL=INFO
DEBUG=0

# Database (Postgres in production; SQLite fallback for local dev)
DATABASE_URL=sqlite:///nebula_dev.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/nebula

# Redis (optional in dev — falls back to in-memory)
REDIS_URL=

# LemonSqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PREMIUM_MONTHLY=
LEMONSQUEEZY_VARIANT_PREMIUM_YEARLY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Nebula Scanner <noreply@nebulascanner.com>

# Monitoring
SENTRY_DSN=

# Groq (AI destek chatbot'u + bilanço analizi — Llama 3.3)
GROQ_API_KEY=

# Legal entity (footer)
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
SUPPORT_EMAIL=destek@nebulascanner.com

# Admin bootstrap (for /api/cache/clear etc. before login flow exists)
ADMIN_EMAILS=
