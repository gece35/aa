# Nebula Scanner — environment variables
# Copy to .env and fill in. Never commit .env.

# Flask
SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:5000
# Sitenin herkese açık adresi (canonical, sitemap, bülten bağlantıları). Boşsa üretimde
# https://nebulascanner.com, DEBUG=1 iken APP_BASE_URL kullanılır.
# SITE_URL=https://nebulascanner.com
LOG_LEVEL=INFO
DEBUG=0

# Database (Postgres in production; SQLite fallback for local dev)
DATABASE_URL=sqlite:///nebula_dev.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/nebula

# Arka plan zamanlayıcısı (fiyat alarmı kontrolü, hesap temizliği) web sürecinin
# içinde, yalnızca gunicorn altında çalışır. Lokal denemek için RUN_SCHEDULER=1,
# tek seferlik çalıştırmak için: python -m backend.worker --once
# SCHEDULER_DISABLED=1          # zamanlayıcıyı tamamen kapatır
# SCHEDULER_TICK_SECONDS=300    # kontrol aralığı (sn)
# WEB_THREADS=8                 # gunicorn thread sayısı (tek süreç)
# AUTO_MIGRATE=0                # açılışta otomatik migration'ı kapatır

# Haftalık bülten (Pazar 10:00 TSİ). Varsayılan KAPALI; önce admin test gönderimini deneyin.
NEWSLETTER_ENABLED=0
# NEWSLETTER_DAILY_CAP=250      # günlük e-posta üst sınırı (Brevo ücretsiz: 300/gün)

# LemonSqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PREMIUM_MONTHLY=
LEMONSQUEEZY_VARIANT_PREMIUM_YEARLY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Nebula Scanner <noreply@nebulascanner.com>

# Monitoring
SENTRY_DSN=

# Groq (AI destek chatbot'u + bilanço analizi — Llama 3.3)
GROQ_API_KEY=

# Legal entity (footer)
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
SUPPORT_EMAIL=destek@nebulascanner.com

# Admin bootstrap (for /api/cache/clear etc. before login flow exists)
ADMIN_EMAILS=
